# Meta Business OS — Phase 1 environment template.
# Copy to .env for local development. Placeholders only — no real values.
# NEVER commit a real .env, token key, or Meta app secret.

# Port the HTTP server listens on.
META_OS_PORT=3000

# SQLite database path (relative to app/ or absolute). Use :memory: for tests.
META_OS_DB_PATH=./data/meta-business-os.sqlite

# Base64 of a random 32-byte key used to encrypt stored Meta asset tokens
# (AES-256-GCM). Generate one with: openssl rand -base64 32
# If unset, the server generates an ephemeral key per process and warns:
# encrypted tokens will NOT survive a restart. Dev only.
META_OS_TOKEN_KEY=

# true = use the mock Meta connector (Phase 1 default; no real Meta calls).
META_OS_MOCK_META=true

# Meta app credentials for asset OAuth (Phase 1: leave empty; no real calls).
META_OS_META_APP_ID=
META_OS_META_APP_SECRET=

# Meta permission scopes, comma-separated. Empty by default.
# NEVER invent Meta permission names — only scopes confirmed in the
# Phase 0 API audit may be listed here.
META_OS_META_SCOPES=

# Hours after which a pending approval expires and can never execute.
APPROVAL_EXPIRY_HOURS=168

# Session lifetime (hours) and idle timeout (hours).
SESSION_TTL_HOURS=24
SESSION_IDLE_HOURS=2
